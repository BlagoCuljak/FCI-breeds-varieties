{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fci-breeds-varieties",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "fci.dogshowonline.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
